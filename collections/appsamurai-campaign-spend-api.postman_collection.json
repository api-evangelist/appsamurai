        {
          "id": "62e23bee-092b-4d11-9c3b-07e6a58e8d99",
          "name": "Retrieve campaign spend data",
          "request": {
            "name": "Retrieve campaign spend data",
            "description": {
              "content": "Returns campaign spend data for the account identified by the API key supplied in the path. If end_date is omitted the API returns data for the last 30 days. The API key is the unique token provided by your AppSamurai account manager.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "api",
                "customer-pull",
                "spent",
                ":api_key"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "start_date",
                  "value": "<date>",
                  "description": "Beginning date of the retrieval period (YYYY-MM-DD)."
                },
                {
                  "disabled": false,
                  "key": "end_date",
                  "value": "<date>",
                  "description": "End date of the retrieval period (YYYY-MM-DD). Defaults to the last 30 days when omitted."
                },
                {
                  "disabled": false,
                  "key": "campaign_id",
                  "value": "<string>",
                  "description": "Filter to a specific campaign ID."
                },
                {
                  "disabled": false,
                  "key": "bundle_id",
                  "value": "<string>",
                  "description": "Filter results by a specific application bundle ID."
                },
                {
                  "disabled": false,
                  "key": "platform",
                  "value": "<string>",
                  "description": "Limit data to a particular platform."
                },
                {
                  "disabled": false,
                  "key": "campaign_name",
                  "value": "<string>",
                  "description": "Filter data by campaign name."
                },
                {
                  "disabled": false,
                  "key": "country",
                  "value": "<string>",
                  "description": "Filter results by country using ISO 3166-1 alpha-2 codes (e.g. US, GB)."
                }
              ],
              "variable": [
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<string>",
                  "key": "api_key",
                  "description": "(Required) Unique API key provided by your AppSamurai account manager. Acts as the credential."
                }
              ]
            },
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "GET",
            "auth": {
              "type": "apikey",
              "apikey": [
                {
                  "key": "key",
                  "value": "api_key"
                },
                {
                  "key": "value",
                  "value": "{{apiKey}}"
                },
                {
                  "key": "in",
                  "value": "query"
                }
              ]
            }
          },
